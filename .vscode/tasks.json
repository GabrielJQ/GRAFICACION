{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Construir OpenGL",
            "command": "C:/MinGW/bin/g++.exe",
            "args": [
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Matrix3D.cpp",
                "${workspaceFolder}/src/Punto3D.cpp",
                "${workspaceFolder}/src/Renderer3D.cpp",
                "${workspaceFolder}/src/glad.c",
                "-I${workspaceFolder}/include",
                "-L${workspaceFolder}/lib",
                "-l:libglfw3dll.a",
                "-lopengl32",
                "-lglu32",
                "-lgdi32",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}